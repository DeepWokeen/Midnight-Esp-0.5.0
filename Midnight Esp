local WindowOpen=false
local WINDOW_FADE_TIME=0.36
local windowFadeToken=0
local windowFadeTweens={}
local windowFadeTargets=nil

local function stopWindowFade()
 for _,tw in ipairs(windowFadeTweens) do
  pcall(function() tw:Cancel() end)
 end
 table.clear(windowFadeTweens)
end

local function getFadeProperties(obj)
 local props={}
 if obj:IsA("GuiObject") then
  props.BackgroundTransparency=obj.BackgroundTransparency
  if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
   props.TextTransparency=obj.TextTransparency
   props.TextStrokeTransparency=obj.TextStrokeTransparency
  end
  if obj:IsA("ImageLabel") or obj:IsA("ImageButton") or obj:IsA("ViewportFrame") then
   props.ImageTransparency=obj.ImageTransparency
  end
  if obj:IsA("ScrollingFrame") then
   props.ScrollBarImageTransparency=obj.ScrollBarImageTransparency
  end
 elseif obj:IsA("UIStroke") then
  props.Transparency=obj.Transparency
 end
 return props
end

local function isVisibleInWindow(obj)
 if obj:IsA("GuiObject") and not obj.Visible then return false end
 local parent=obj.Parent
 while parent and parent~=Window do
  if parent:IsA("GuiObject") and not parent.Visible then return false end
  parent=parent.Parent
 end
 return parent==Window
end

local function collectVisibleFadeProperties()
 local visible={}
 for _,obj in ipairs(Window:GetDescendants()) do
  if isVisibleInWindow(obj) then
   local props=getFadeProperties(obj)
   if next(props) then visible[obj]=props end
  end
 end
 return visible
end

local function mergeFadeTargets(current,previous)
 local targets={}
 -- Use the saved destination for objects already animating, not their partial
 -- transparency at the moment the user interrupts the animation.
 for obj,props in pairs(current) do
  targets[obj]=(previous and previous[obj]) or props
 end
 if previous then
  for obj,props in pairs(previous) do
   if obj and obj.Parent and not targets[obj] then targets[obj]=props end
  end
 end
 return targets
end

local function setOpacity(obj,props,transparent)
 if not obj or not obj.Parent then return end
 for property,original in pairs(props) do
  local goal=transparent and 1 or original
  pcall(function() obj[property]=goal end)
 end
end

-- Keep UIStroke instances from flashing for a rendered frame when the root
-- window is hidden and the original transparency values are restored.
local windowFadeStrokeEnabled=setmetatable({}, {__mode="k"})
local function disableWindowFadeStrokes(targets)
 for obj in pairs(targets) do
  if obj and obj.Parent and obj:IsA("UIStroke") then
   if windowFadeStrokeEnabled[obj]==nil then
    windowFadeStrokeEnabled[obj]=obj.Enabled
   end
   pcall(function() obj.Enabled=false end)
  end
 end
end
local function restoreWindowFadeStrokes(targets)
 for obj in pairs(targets) do
  if obj and obj.Parent and obj:IsA("UIStroke") then
   local enabled=windowFadeStrokeEnabled[obj]
   if enabled~=nil then
    -- Apply invisibility before re-enabling, then let the normal fade tween
    -- bring the stroke back to its authored transparency.
    pcall(function() obj.Transparency=1 end)
    pcall(function() obj.Enabled=enabled end)
    windowFadeStrokeEnabled[obj]=nil
   end
  end
 end
end

function F.setWindowOpen(open,instant)
 open=not not open
 windowFadeToken=windowFadeToken+1
 local token=windowFadeToken
 stopWindowFade()
 WindowOpen=open
 MenuFadeActive=not instant
 -- The parent CanvasGroup stays opaque; fade each visible UI element directly
 -- to avoid environments where CanvasGroup transparency tweens render instantly.
 pcall(function() Window.GroupTransparency=0 end)

 if not open and not Root.Visible then
  windowFadeTargets=nil
  MenuFadeActive=false
  return
 end

 local wasVisible=Root.Visible
 local currentProperties=collectVisibleFadeProperties()
 local targets=mergeFadeTargets(currentProperties,windowFadeTargets)

 if open and not wasVisible then
  -- A fully hidden window starts transparent. Interruptions keep their current
  -- alpha and tween back to the original destination instead of flashing.
  for obj,props in pairs(targets) do
   setOpacity(obj,props,true)
  end
  -- Re-enable outlines only after they have been made fully transparent.
  restoreWindowFadeStrokes(targets)
  Root.Visible=true
 else
  -- For closing, keep Root visible until the opacity animation has finished.
  Root.Visible=true
 end

 windowFadeTargets=targets

 if instant then
  if open then
   for obj,props in pairs(targets) do setOpacity(obj,props,false) end
   restoreWindowFadeStrokes(targets)
   Root.Visible=true
  else
   -- Disable strokes before restoring original transparencies so they cannot
   -- briefly reappear at the end of a close transition.
   disableWindowFadeStrokes(targets)
   Root.Visible=false
   for obj,props in pairs(targets) do setOpacity(obj,props,false) end
  end
  windowFadeTargets=nil
  table.clear(windowFadeTweens)
  MenuFadeActive=false
  return
 end

 local tweens={}
 for obj,props in pairs(targets) do
  if obj and obj.Parent then
   local goals={}
   for property,original in pairs(props) do
    goals[property]=open and original or 1
   end
   local ok,tw=pcall(function()
    return TweenService:Create(obj,TweenInfo.new(WINDOW_FADE_TIME,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),goals)
   end)
   if ok and tw then table.insert(tweens,tw) end
  end
 end
 windowFadeTweens=tweens
 for _,tw in ipairs(tweens) do pcall(function() tw:Play() end) end

 -- A fixed completion guard means the menu is not dependent on any single
 -- Tween.Completed callback to finish its fade or hide the root.
 task.delay(WINDOW_FADE_TIME+0.06,function()
  if token~=windowFadeToken or WindowOpen~=open then return end
  if not open then
   -- Stop any late theme/hover updates from drawing borders during the frame
   -- where the root becomes hidden. The original Enabled state is restored on
   -- the next open, after the strokes have first been set transparent.
   disableWindowFadeStrokes(targets)
   Root.Visible=false
   for obj,props in pairs(targets) do setOpacity(obj,props,false) end
  end
  windowFadeTargets=nil
  table.clear(windowFadeTweens)
  MenuFadeActive=false
 end)
end
