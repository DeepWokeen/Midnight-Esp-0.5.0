        top = Color3.fromHSV(h, sat * 0.55, 0.34)
        bottom = Color3.fromHSV(h, sat * 0.85, 0.07)
    end

    if Config.UIRainbow then
        local shift = (tick() * 0.08) % 1
        local function shiftColor(color)
