function F.safeProfileValue(callback,fallback)
 local ok,value=pcall(callback)
 if ok and value~=nil then return value end
 return fallback
end
function F.shortServerId(value)
 if type(value)~="string" or value=="" then return F.t("profile_studio") end
 if #value<=16 then return value end
 return value:sub(1,8).."..."..value:sub(-5)
end
function F.updateProfileInfo()
 if not ProfilePage or not ProfilePage.Parent then return end
 ProfilePageName.Text=LocalPlayer.DisplayName
 ProfilePageUser.Text="@"..LocalPlayer.Name
 ProfileValues.profile_display.Text=LocalPlayer.DisplayName
 ProfileValues.profile_username.Text="@"..LocalPlayer.Name
 ProfileValues.profile_userid.Text=tostring(LocalPlayer.UserId)
 local age=F.safeProfileValue(function()return LocalPlayer.AccountAge end,0)
 ProfileValues.profile_age.Text=tostring(age).." days"
 local membership=F.safeProfileValue(function()return LocalPlayer.MembershipType.Name end,"Unknown")
 if membership=="None" then membership=F.t("profile_standard") end
 ProfileValues.profile_membership.Text=tostring(membership)
 ProfileValues.profile_locale.Text=tostring(F.safeProfileValue(function()return LocalPlayer.LocaleId end,F.t("profile_unavailable")))
 ProfileValues.profile_game.Text=ProfileGameName
 ProfileValues.profile_universe.Text=tostring(game.GameId)
 ProfileValues.profile_place.Text=tostring(game.PlaceId)
 local privateId=F.safeProfileValue(function()return game.PrivateServerId end,"")
 local ownerId=F.safeProfileValue(function()return game.PrivateServerOwnerId end,0)
 local serverType=F.t("profile_public")
 if privateId~="" then serverType=(ownerId and ownerId>0)and F.t("profile_private")or F.t("profile_reserved") end
 ProfileValues.profile_server_type.Text=serverType
 ProfileValues.profile_server.Text=F.shortServerId(F.safeProfileValue(function()return game.JobId end,""))
 ProfileValues.profile_players.Text=tostring(#Players:GetPlayers()).." / "..tostring(Players.MaxPlayers)
 ProfileValues.profile_version.Text=tostring(F.safeProfileValue(function()return game.PlaceVersion end,0))
 local character=LocalPlayer.Character
 local humanoid=character and character:FindFirstChildOfClass("Humanoid")
 local rootPart=character and character:FindFirstChild("HumanoidRootPart")
 if not character or not humanoid then
  ProfileValues.profile_status.Text=F.t("profile_no_character")
  ProfileValues.profile_health.Text="--"
  ProfileValues.profile_position.Text="--"
  ProfileValues.profile_speed.Text="--"
  ProfileValues.profile_jump.Text="--"
  ProfileValues.profile_rig.Text="--"
  ProfileValues.profile_tool.Text="--"
  ProfileOnlineDot.BackgroundColor3=Color3.fromRGB(235,90,90)
 else
  local aliveCharacter=humanoid.Health>0
  ProfileValues.profile_status.Text=aliveCharacter and F.t("profile_alive")or F.t("profile_dead")
  ProfileValues.profile_health.Text=string.format("%d / %d",math.max(0,math.floor(humanoid.Health+0.5)),math.max(0,math.floor(humanoid.MaxHealth+0.5)))
  ProfileValues.profile_speed.Text=string.format("%.1f",humanoid.WalkSpeed)
  local jumpValue=humanoid.UseJumpPower and humanoid.JumpPower or humanoid.JumpHeight
  ProfileValues.profile_jump.Text=string.format("%.1f %s",jumpValue,humanoid.UseJumpPower and "Power"or"Height")
  ProfileValues.profile_rig.Text=humanoid.RigType.Name
  ProfileOnlineDot.BackgroundColor3=aliveCharacter and Color3.fromRGB(70,220,130)or Color3.fromRGB(235,90,90)
  if rootPart then
   local pos=rootPart.Position
   ProfileValues.profile_position.Text=string.format("%.0f, %.0f, %.0f",pos.X,pos.Y,pos.Z)
  else
   ProfileValues.profile_position.Text="--"
  end
  local equipped="--"
  for _,child in ipairs(character:GetChildren())do
   if child:IsA("Tool")then equipped=child.Name break end
  end
  ProfileValues.profile_tool.Text=equipped
 end
