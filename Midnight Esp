local function playRadioTrack(track,index)
 stopRadio()
 if index then RadioTrackIndex=index end
 local id=tostring(track[2])
 local sound=Instance.new("Sound")
 sound.Name="MidnightMiniRadio"
 sound.SoundId="rbxassetid://"..id
 sound.Volume=0.35*(math.clamp(tonumber(Config.RadioVolume) or 100,0,200)/100)
 sound.Looped=false
 sound.Parent=SoundService
 RadioSound=sound
 RadioStatus.Text="LOADING • "..track[1]
 task.spawn(function()
  local started=os.clock()
  while alive and RadioSound==sound and not sound.IsLoaded and os.clock()-started<12 do
   task.wait(0.1)
  end
  if not alive or RadioSound~=sound then return end
  if sound.IsLoaded then
   local ok,err=pcall(function() sound:Play() end)
   if ok then
    RadioStatus.Text="PLAYING • "..track[1]
   else
    RadioStatus.Text="PLAY ERROR • "..track[1]
   end
  else
   RadioStatus.Text="UNAVAILABLE • "..track[1]
  end
 end)
end
