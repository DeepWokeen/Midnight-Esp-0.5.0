            top = Color3.fromHSV(h1, math.min(s1, 0.8) * 0.6, 0.38)
            bottom = Color3.fromHSV(h2, math.min(s2, 0.85) * 0.9, 0.08)
        end
    else
        local base = th.Rainbow and Color3.fromHSV((tick() * 0.1) % 1, 0.65, 1) or th.Accent
        local h, saturation, value = base:ToHSV()
        accent = base
        accent2 = th.Accent2 or Color3.fromHSV((h + 0.07) % 1, saturation, math.max(value * 0.85, 0.5))
