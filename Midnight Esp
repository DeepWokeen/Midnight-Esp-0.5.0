function F.selectTab(key,animate)
 local prev=SelectedTab
 if not Tabs[key] then return end
 local changed=(prev~=key)
 SelectedTab=key
 if key=="tab_settings" and changed and animate and Tabs[key].settingsGear then
  local gear=Tabs[key].settingsGear
  if Tabs[key].settingsGearTween then
   pcall(function() Tabs[key].settingsGearTween:Cancel() end)
  end
  gear.Rotation=0
  local spin=TweenService:Create(
   gear,
   TweenInfo.new(0.9,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut,0,false,0),
   {Rotation=360}
  )
  Tabs[key].settingsGearTween=spin
  spin:Play()
 end
 -- Hide the outgoing page before showing the incoming page so their contents never overlap.
 if changed and Tabs[prev] then
  local oldPage=Tabs[prev].page
  oldPage.Visible=false
  oldPage.GroupTransparency=0
  oldPage.Position=UDim2.new()
 end
 for i,k in ipairs(TAB_KEYS) do
  local tab=Tabs[k]
  local sel=(k==key)
  -- Keep tab text stable across theme changes; the navigation background is dark.
  -- A fixed light foreground prevents the labels flickering between black and white
  -- while animated palettes move through bright and dark accent colors.
  local col=WHITE
  -- Keep the active tab readable while preserving its accent outline.
  if tab.buttonStroke then
   -- Only the selected tab may display a fill/gradient. Apply states immediately
   -- so the previous tab cannot remain highlighted during a transition.
   tab.button.BackgroundColor3=sel and C.accent2:Lerp(C.accent,0.45) or WHITE
   tab.button.BackgroundTransparency=sel and 0.12 or 1
   tab.buttonStroke.Color=C.accent
   if not MenuFadeActive then
    tab.buttonStroke.Transparency=sel and 0.08 or 0.62
   end
   if tab.buttonGradient then
    tab.buttonGradient.Enabled=sel
    tab.buttonGradient.Transparency=sel and NumberSequence.new(0) or NumberSequence.new(1)
   end
  end
  if animate then F.tween(tab.label,0.3,{TextColor3=col},Enum.EasingStyle.Sine); F.tween(tab.iconStroke,0.3,{Color=col},Enum.EasingStyle.Sine)
  else tab.label.TextColor3=col; tab.iconStroke.Color=col;  end
  -- Only the Settings tab hides its legacy circle behind the gear glyph.
  -- Other tab circles keep their normal selected/unselected sizes.
  local isSettings=(k=="tab_settings")
  local size=isSettings and UDim2.fromOffset(1,1) or (sel and UDim2.fromOffset(11,11) or UDim2.fromOffset(14,14))
  local rot=(not isSettings and sel) and 45 or 0
  local fillT=(isSettings or not sel) and 1 or 0.6
  local corner=(not isSettings and sel) and UDim.new(0,3) or FULL
  if animate then
   F.tween(tab.icon,0.55,{Size=size,Rotation=rot},Enum.EasingStyle.Back)
   F.tween(tab.icon,0.3,{BackgroundTransparency=fillT},Enum.EasingStyle.Sine)
   F.tween(tab.iconCorner,0.45,{CornerRadius=corner},Enum.EasingStyle.Quad)
  else
   tab.icon.Size=size; tab.icon.Rotation=rot; tab.icon.BackgroundTransparency=fillT; tab.iconCorner.CornerRadius=corner
  end
  -- The active tab is indicated by its own outline/fill, not a separate moving selector.
 end
 Selector.Visible=false
 local page=Tabs[key].page
 page.GroupTransparency=animate and changed and 1 or 0
 page.Position=(animate and changed) and UDim2.fromOffset(0,12) or UDim2.new()
 page.Visible=true
 if animate and changed then F.tween(page,0.28,{GroupTransparency=0,Position=UDim2.new()},Enum.EasingStyle.Quad) end
end
