function F.paletteColor(pal,pos)local n=#pal local x=(pos%1)*n local i=math.floor(x)local f=x-i f=f*f*(3-2*f)return pal[i%n+1]:Lerp(pal[(i+1)%n+1],f)end
function F.targetColors(th)
    local accent, accent2, top, bottom

    if th.Top then
        accent = th.Accent
        accent2 = th.Accent2 or th.Accent
        top = th.Top
        bottom = th.Bottom
    elseif th.Flow then
        local phase = tick() * (th.Speed or 0.05)
        accent = F.paletteColor(th.Flow, phase)
        accent2 = F.paletteColor(th.Flow, phase + 0.4)

